---
/**
 * Fades its content in when the visitor scrolls it up into view. The content
 * is fully shown by default: without JavaScript, with reduced motion, or when
 * the page is laid out at once (a full-page capture resizes, it does not
 * scroll), nothing is ever hidden. A section already on screen when the page
 * loads, after a reload or a back navigation that restores the scroll, never
 * fades either.
 */
---

<div data-reveal>
  <slot />
</div>

<script>
  let stopPreviousReveal: (() => void) | undefined;

  function revealOnScroll() {
    stopPreviousReveal?.();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let visitorHasScrolled = false;
    const markScrolled = () => (visitorHasScrolled = true);
    addEventListener('scroll', markScrolled, { once: true, passive: true });

    // The observer's first report describes the page as it loaded.
    const reported = new WeakSet<Element>();

    const observer = new IntersectionObserver((entries) => {
      for (const { isIntersecting, target, boundingClientRect } of entries) {
        const onScreenAtLoad = !reported.has(target) && isIntersecting;
        reported.add(target);
        if (!isIntersecting) continue;
        observer.unobserve(target);
        const comesUpFromBelow = boundingClientRect.top > 0;
        if (onScreenAtLoad || !visitorHasScrolled || !comesUpFromBelow) {
          continue;
        }
        target.classList.add('reveal-entering');
        target.addEventListener(
          'animationend',
          () => target.classList.remove('reveal-entering'),
          { once: true }
        );
      }
    });
    for (const element of document.querySelectorAll('[data-reveal]')) {
      observer.observe(element);
    }

    stopPreviousReveal = () => {
      observer.disconnect();
      removeEventListener('scroll', markScrolled);
    };
  }

  document.addEventListener('astro:page-load', revealOnScroll);
</script>

<style is:global>
  @keyframes reveal-entering {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .reveal-entering {
    animation: reveal-entering 0.5s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-entering {
      animation: none;
    }
  }
</style>
