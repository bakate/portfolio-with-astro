---
import { defaultLanguage, type LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { cn } from '@/lib/utils';
import ThemeToggle from './ThemeToggle.astro';
import { LanguageSelector } from './LanguageSelector';
import { type LanguageSelectorItem } from '@/lib/i18n-utils';

import type { NavItem } from '@/layouts/BaseLayout.astro';
import { buttonVariants } from './ui/button';

const currentLocale =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const currentPathname = Astro.url.pathname;

export interface Props {
  navItems: NavItem[];
  languagesForSelector: LanguageSelectorItem[];
}

const { navItems, languagesForSelector } = Astro.props;
---

<nav
  class="md:hidden fixed bottom-0 left-0 z-50 w-full bg-background/95 backdrop-blur-xl contrast-more:bg-background p-2 border-t border-border"
  role="navigation"
  aria-label="Main navigation"
>
  <div
    class:list={[
      'flex h-16 max-w-screen-sm mx-auto justify-around items-center px-1',
    ]}
  >
    {
      navItems.map((item) => {
        const localizedHref = getRelativeLocaleUrl(currentLocale, item.href);

        let isActive = currentPathname === localizedHref;
        if (
          item.href === '/' &&
          localizedHref !== '/' &&
          currentPathname === localizedHref.replace(/\/$/, '')
        ) {
          isActive = true;
        }
        if (
          item.href !== '/' &&
          currentPathname.startsWith(`${localizedHref}/`)
        ) {
          isActive = true;
        }
        if (
          item.href === '/' &&
          localizedHref === '/' &&
          currentPathname === '/'
        ) {
          isActive = true;
        }

        const Icon = item.icon;
        const title = item.label;

        return (
          <a
            href={localizedHref}
            aria-label={title}
            aria-current={isActive ? 'page' : undefined}
            class={cn(
              'relative flex flex-col items-center justify-center transition-colors duration-200 flex-1 min-w-0 px-0.5',
              isActive
                ? 'text-primary font-semibold'
                : 'text-muted-foreground hover:text-foreground'
            )}
            style="min-height: 48px;"
          >
            <span
              class={cn(
                'flex items-center justify-center rounded-full transition bg-transparent',
                isActive ? 'bg-primary/10' : ''
              )}
              style="width: 32px; height: 32px;"
            >
              <Icon class="size-4.5" />
            </span>
            <span class="text-[9px] sm:text-[10px] whitespace-nowrap overflow-hidden text-ellipsis max-w-full text-center leading-tight mt-1 px-1">
              {title}
            </span>
            {isActive && (
              <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-4 h-0.5 rounded-full bg-primary" />
            )}
          </a>
        );
      })
    }
    {/* Additional Controls */}
    <div class="flex items-center gap-x-1 pl-1 shrink-0 border-l border-border/50 ml-1">
      <LanguageSelector
        currentLocale={currentLocale}
        languages={languagesForSelector}
        client:load
      />
      <ThemeToggle />
    </div>
  </div>
</nav>
