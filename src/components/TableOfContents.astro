---
import { useTranslations, type LanguageCode } from '@/i18n/ui';

interface Props {
  headings: Array<{ depth: number; text: string; slug: string }>;
  lang: LanguageCode;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang, 'blogPost'); // Or generic labels

// Filter only secondary and tertiary headings for the TOC
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{
  filteredHeadings.length > 0 && (
    <nav class="toc-nav space-y-4" aria-label="Table of contents">
      <h2 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">
        {t('tableOfContents') || 'Sommaire'}
      </h2>
      <ul class="space-y-2 text-sm">
        {filteredHeadings.map((heading) => (
          <li
            style={`padding-left: ${(heading.depth - 2) * 1}rem`}
            class="transition-all duration-200"
          >
            <a
              href={`#${heading.slug}`}
              class="toc-link block text-muted-foreground hover:text-primary transition-colors border-l-2 border-transparent pl-3 py-1 data-[active=true]:border-primary data-[active=true]:text-primary data-[active=true]:font-medium"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  function setupToc() {
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -70% 0px',
      threshold: 1.0,
    };

    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = Array.from(tocLinks)
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((section) => section !== null) as HTMLElement[];

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.setAttribute('data-active', isActive ? 'true' : 'false');
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
  }

  // Initialize on page load and after view transitions
  setupToc();
  document.addEventListener('astro:after-swap', setupToc);
</script>
