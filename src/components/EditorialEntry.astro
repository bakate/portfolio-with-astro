---
import type { LanguageCode } from '@/i18n/ui';
import { formatDate } from '@/lib/utils';

/**
 * One article or tip in a list: when and how long on the left, what and why
 * on the right. Shared by the blog, the tips and the home page so they read
 * as one editorial voice.
 */
export type Props = {
  title: string;
  href: string;
  description: string;
  pubDate: Date;
  lang: LanguageCode;
  /** 2 when the entry sits right under the page title, 3 under a section heading. */
  headingLevel: 2 | 3;
  /** Shown in the accent colour before the date: the kind of entry or its difficulty. */
  label?: string;
  /** Short facts under the date, such as the reading time. */
  details?: ReadonlyArray<string>;
  tags?: ReadonlyArray<string>;
  /** Marks the entry for a FilterableList around it. */
  filterId?: string;
};

const {
  title,
  href,
  description,
  pubDate,
  lang,
  headingLevel,
  label,
  details = [],
  tags = [],
  filterId,
} = Astro.props;
const Title = `h${headingLevel}` as const;
---

<article
  data-entry-id={filterId}
  class="grid gap-2 border-b border-border py-8 md:grid-cols-[14rem_1fr] md:gap-10"
>
  <p class="text-sm text-muted-foreground md:pt-1">
    {label && <span class="font-medium text-primary">{label} · </span>}
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    {details.map((detail) => <span class="block">{detail}</span>)}
  </p>
  <div>
    <Title class="font-heading text-xl font-semibold tracking-tight">
      <a
        href={href}
        class="underline-offset-4 hover:text-primary hover:underline"
      >
        {title}
      </a>
    </Title>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {description}
    </p>
    {
      tags.length > 0 && (
        <p class="mt-4 text-sm text-muted-foreground">{tags.join(' · ')}</p>
      )
    }
  </div>
</article>
