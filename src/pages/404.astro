---
import { buttonVariants } from '@/components/ui/button';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowLeft } from 'lucide-react';

// The static build has a single 404.html, served for every unknown address,
// French or English, so the page speaks both languages.
const tFr = useTranslations('fr', 'notFoundPage');
const tEn = useTranslations('en', 'notFoundPage');
---

<BaseLayout
  pageTitle={tFr('pageTitle')}
  pageDescription={tFr('message')}
  noIndex
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-2xl px-4">
      <p
        class="font-heading text-6xl font-bold text-primary"
        aria-hidden="true"
      >
        404
      </p>

      <h1 class="mt-6 text-3xl font-bold sm:text-4xl">{tFr('title')}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        {tFr('message')}
      </p>
      <a
        href={getRelativeLocaleUrl('fr', '/')}
        class:list={[buttonVariants({ variant: 'default' }), 'mt-6']}
      >
        <ArrowLeft className="size-4" aria-hidden="true" />
        {tFr('homeLink')}
      </a>

      <div lang="en" class="mt-12 border-t border-border pt-8">
        <h2 class="text-2xl font-semibold">{tEn('title')}</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          {tEn('message')}
        </p>
        <a
          href={getRelativeLocaleUrl('en', '/')}
          class:list={[buttonVariants({ variant: 'outline' }), 'mt-6']}
        >
          <ArrowLeft className="size-4" aria-hidden="true" />
          {tEn('homeLink')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
