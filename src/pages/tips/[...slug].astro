---
import { TipLayout } from '@/features/tips';
import { defaultLanguage } from '@/i18n/ui';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  // Drafts are built at their final address but never listed (see index.astro),
  // so they can be reviewed through a hidden URL; the layout marks them noindex.
  const tips = await getCollection('tips', ({ id }) => {
    return id.startsWith(`${defaultLanguage}/`);
  });

  return tips.map((tip) => ({
    params: { slug: tip.id },
    props: { tip },
  }));
}

type Props = {
  tip: CollectionEntry<'tips'>;
};

const { tip } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(tip);
---

<TipLayout
  tip={tip}
  headings={headings}
  readingTimeMinutes={remarkPluginFrontmatter.readingTimeMinutes}
>
  <Content />
</TipLayout>
