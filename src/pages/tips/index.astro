---
import { AllTipsScreen, getPublishedTips } from '@/features/tips';
import { defaultLanguage, ui, type LanguageCode } from '@/i18n/ui';

const lang = (Astro.currentLocale ?? defaultLanguage) as LanguageCode;
const tips = await getPublishedTips(lang);
---

<AllTipsScreen tips={tips} lang={lang} copy={ui[lang].tipsPage} />
