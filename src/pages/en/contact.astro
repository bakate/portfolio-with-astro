---
import { ContactScreen } from '@/features/contact';
import { defaultLanguage, ui, type LanguageCode } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';

const lang =
  (Astro.currentLocale as LanguageCode | undefined) ?? defaultLanguage;
const copy = ui[lang].contactPage;
---

<BaseLayout pageTitle={copy.pageTitle} pageDescription={copy.pageDescription}>
  <ContactScreen lang={lang} copy={copy} />
</BaseLayout>
