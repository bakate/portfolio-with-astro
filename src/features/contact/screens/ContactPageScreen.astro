---
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { analyticsEvents } from '@/lib/analytics';
import { profile } from '@/lib/profile';
import { Calendar } from 'lucide-react';

import { ContactForm } from '../components/ContactForm.tsx';
import type { ContactPageCopy } from '../type';

interface Props {
  lang: LanguageCode;
  copy: ContactPageCopy;
}

const { lang, copy } = Astro.props;

const linkClass =
  'font-medium text-foreground underline underline-offset-4 hover:text-primary';
---

<section class="py-12 md:py-16">
  <div class="mx-auto max-w-2xl px-4">
    <h1 class="text-3xl font-bold sm:text-4xl">{copy.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
      {copy.description}
    </p>
    <p class="mt-2 font-medium">{copy.freelanceLine}</p>

    {/* Booking first: the fastest way to talk. */}
    <div class="mt-10 rounded-lg border border-border bg-card p-6 md:p-8">
      <h2 class="text-2xl font-semibold">{copy.bookingTitle}</h2>
      <p class="mt-2 text-muted-foreground">{copy.bookingDescription}</p>
      <a
        href={profile.bookingUrl}
        data-umami-event={analyticsEvents.bookCall}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          buttonVariants({ variant: 'default', size: 'lg' }),
          'mt-6',
        ]}
      >
        <Calendar className="size-4" aria-hidden="true" />
        {copy.bookingLinkLabel}
      </a>
    </div>

    <div class="mt-10 rounded-lg border border-border bg-card p-6 md:p-8">
      <h2 id="contact-form-heading" class="text-2xl font-semibold">
        {copy.formHeading}
      </h2>
      <p class="mt-2 mb-8 text-muted-foreground">{copy.responseTime}</p>
      <ContactForm
        client:load
        {lang}
        formTranslations={copy}
        labelledBy="contact-form-heading"
      />
    </div>

    <p class="mt-10 text-sm text-muted-foreground">
      {copy.elsewhereLabel}{' '}
      <a
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}>{copy.linkedInLabel}</a
      >
      ·
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}>{copy.githubLabel}</a
      >
    </p>
  </div>
</section>
