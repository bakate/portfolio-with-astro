---
import { ArrowRight } from 'lucide-react';

export type ExperienceSummaryEntry = {
  company: string;
  role: string;
  period: string;
  summary: string;
};

export type Props = {
  title: string;
  description: string;
  cta: string;
  ctaHref: string;
  entries: ReadonlyArray<ExperienceSummaryEntry>;
};

const { title, description, cta, ctaHref, entries } = Astro.props;
---

<section id="experience" class="py-16 md:py-24">
  <div class="max-w-3xl">
    <h2 class="font-heading text-2xl font-bold tracking-tight sm:text-3xl">
      {title}
    </h2>
    <p class="mt-4 text-muted-foreground">{description}</p>
  </div>

  <ol class="mt-12 border-t border-border">
    {
      entries.map((entry) => (
        <li class="grid gap-2 border-b border-border py-8 md:grid-cols-[14rem_1fr] md:gap-10">
          <p class="text-sm text-muted-foreground md:pt-1">{entry.period}</p>
          <div>
            <h3 class="font-heading text-xl font-semibold tracking-tight">
              {entry.company}
            </h3>
            <p class="mt-1 font-medium text-primary">{entry.role}</p>
            <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
              {entry.summary}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <a
    href={ctaHref}
    class="mt-8 inline-flex items-center gap-2 font-medium text-primary underline-offset-4 hover:underline"
  >
    {cta}
    <ArrowRight className="size-4" aria-hidden="true" />
  </a>
</section>
