---
import { buttonVariants } from '@/components/ui/button';
import type { defaultLanguage, LanguageCode, ui } from '@/i18n/ui';
import { analyticsEvents } from '@/lib/analytics';
import { profile } from '@/lib/profile';
import { ExternalLink, FileDown } from 'lucide-react';

export type ExperienceEntry = {
  company: string;
  companyUrl?: string;
  role: string;
  period: string;
  location: string;
  summary: string;
  highlights: ReadonlyArray<string>;
  technologies: ReadonlyArray<string>;
};

/**
 * Every string of the experience page, keyed like the French copy: passing
 * `ui[lang].experiencePage` fails to compile when a language misses a key.
 */
export type ExperiencePageCopy = Record<
  Exclude<
    keyof (typeof ui)[typeof defaultLanguage]['experiencePage'],
    'entries'
  >,
  string
> & {
  /** Most recent first, as on the CV. */
  entries: ReadonlyArray<ExperienceEntry>;
};

export type Props = {
  lang: LanguageCode;
  copy: ExperiencePageCopy;
};

const { lang, copy } = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="mx-auto max-w-3xl px-4">
    <header
      class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <h1 class="text-3xl font-bold sm:text-4xl">{copy.pageHeading}</h1>
      <a
        href={profile.cvPathByLanguage[lang]}
        download
        data-umami-event={analyticsEvents.downloadCv}
        data-umami-event-language={lang}
        class={buttonVariants({ variant: 'outline', size: 'lg' })}
      >
        <FileDown className="size-4" aria-hidden="true" />
        {copy.downloadCV}
      </a>
    </header>

    <ol class="space-y-12">
      {
        copy.entries.map((experience) => (
          <li class="border-t border-border pt-8">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h2 class="text-2xl font-semibold">
                {experience.companyUrl ? (
                  <a
                    href={experience.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 underline-offset-4 hover:text-primary hover:underline"
                  >
                    {experience.company}
                    <ExternalLink className="size-4" aria-hidden="true" />
                  </a>
                ) : (
                  experience.company
                )}
              </h2>
              <p class="shrink-0 text-sm text-muted-foreground">
                {experience.period} · {experience.location}
              </p>
            </div>
            <p class="mt-1 font-medium text-primary">{experience.role}</p>
            <p class="mt-4 text-muted-foreground">{experience.summary}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed marker:text-primary">
              {experience.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <p class="mt-6 text-sm text-muted-foreground">
              <span class="font-medium text-foreground">{copy.stackLabel}</span>{' '}
              · {experience.technologies.join(' · ')}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="mt-12 border-t border-border pt-8 text-muted-foreground">
      {copy.seekingLabel}
    </p>
  </div>
</section>
