---
import Heading from '@/components/Heading.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { type LanguageCode, defaultLanguage, type ui } from '@/i18n/ui';
import { Image } from 'astro:assets';
import {
  Code,
  ExternalLink,
  CheckCircle,
  AlertTriangle,
  Lightbulb,
  ArrowLeft,
} from 'lucide-react';
import ProjectGallery from '../components/ProjectGallery';
import type { TranslatedProject } from '../type';

export type Props = {
  project: TranslatedProject;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { project, t, lang } = Astro.props;
---

<div class="py-12 md:py-16">
  <article class="prose lg:prose-xl max-w-none dark:prose-invert">
    <a
      href={`${lang !== defaultLanguage ? `/${lang}` : ''}/projects`}
      class={buttonVariants({ variant: 'ghost' }) +
        ' mb-8 no-underline group flex w-fit items-center text-muted-foreground hover:text-foreground'}
    >
      <ArrowLeft
        className="mr-2 size-4 transition-transform group-hover:-translate-x-1"
      />
      {t.projectDetailPage?.backToProjects ?? 'Back to Projects'}
    </a>

    <Heading title={project.title} center={false} />
    <div
      class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground"
    >
      <!-- Category -->
      {
        project.categoryText && (
          <div class="flex items-center gap-2">
            <span class="text-foreground">
              {t.projectDetailPage?.categoryLabel ?? 'Category'}
            </span>
            <Badge variant="secondary">{project.categoryText}</Badge>
          </div>
        )
      }
      <!-- Date -->
      {
        project.dateText && (
          <div class="flex items-center gap-2">
            <span class="text-foreground">
              {t.projectDetailPage?.dateLabel ?? 'Date'}
            </span>
            <Badge variant="secondary">{project.dateText}</Badge>
          </div>
        )
      }
    </div>

    <!-- Image -->
    {
      project.imageUrl && (
        <div class="mb-12 aspect-[16/9] w-full overflow-hidden rounded-lg border border-border">
          <Image
            src={project.imageUrl}
            alt={project.imageAltText}
            class="h-full w-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
          />
        </div>
      )
    }

    <!-- Detailed Description -->
    {
      project.detailedDescription && (
        <section class="mb-8">
          <h2>{t.projectDetailPage?.aboutTitle ?? 'About this project'}</h2>
          <p>{project.detailedDescription}</p>
        </section>
      )
    }

    {
      project.keyFeaturesTranslated &&
        project.keyFeaturesTranslated.length > 0 && (
          <section class="mb-12">
            <h2>{t.projectDetailPage?.keyFeaturesTitle ?? 'Key Features'}</h2>
            <div class="not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 mt-6">
              {project.keyFeaturesTranslated.map((feature) => (
                <div class="flex flex-col gap-2 rounded-xl bg-muted/40 p-5 border border-border/50 hover:bg-muted/60 transition-colors">
                  <div class="flex items-start gap-3">
                    <CheckCircle className="size-5 text-primary shrink-0 mt-0.5" />
                    <span class="font-semibold text-foreground m-0 text-[1.1rem] leading-snug">
                      {feature.title}
                    </span>
                  </div>
                  <p class="text-muted-foreground m-0 text-sm leading-relaxed">
                    {feature.description}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
    }

    {/* Gallery */}

    {
      project.galleryImagesTranslated &&
        project.galleryImagesTranslated.length > 0 && (
          <ProjectGallery
            client:visible
            images={project.galleryImagesTranslated.map((image) => ({
              src: image.src.src,
              alt: image.alt,
              caption: image.caption,
              id: image.id,
            }))}
          />
        )
    }

    {
      (project.challenges || project.learnings) && (
        <div class="not-prose grid grid-cols-1 gap-6 md:grid-cols-2 mb-12 mt-12">
          {project.challenges && (
            <section class="rounded-lg border border-border bg-secondary/20 p-6 flex flex-col">
              <div class="flex items-start gap-3 mb-4">
                <AlertTriangle className="size-6 text-primary shrink-0 mt-0.5" />
                <span class="m-0 font-heading text-xl font-bold tracking-tight">
                  {t.projectDetailPage?.challengesTitle ?? 'Challenges'}
                </span>
              </div>
              <p class="text-muted-foreground leading-relaxed m-0 text-base flex-1">
                {project.challenges}
              </p>
            </section>
          )}

          {project.learnings && (
            <section class="rounded-lg border border-border bg-primary/5 p-6 flex flex-col">
              <div class="flex items-start gap-3 mb-4">
                <Lightbulb className="size-6 text-primary shrink-0 mt-0.5" />
                <span class="m-0 font-heading text-xl font-bold tracking-tight">
                  {t.projectDetailPage?.learningsTitle ?? 'Learnings'}
                </span>
              </div>
              <p class="text-muted-foreground leading-relaxed m-0 text-base flex-1">
                {project.learnings}
              </p>
            </section>
          )}
        </div>
      )
    }

    {/* Project and Code URLs */}
    <div class="mt-8 mb-12 flex flex-col sm:flex-row gap-4 justify-start">
      {
        project.projectUrl && (
          <a
            href={project.projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={
              buttonVariants({ variant: 'default', size: 'lg' }) +
              ' sm:w-auto w-full no-underline'
            }
          >
            <ExternalLink className="mr-2 size-5" />
            {t.projectDetailPage?.visitProjectButton ?? 'Visit Project'}
          </a>
        )
      }
      {
        project.codeUrl && (
          <a
            href={project.codeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={
              buttonVariants({ variant: 'outline', size: 'lg' }) +
              ' sm:w-auto w-full no-underline bg-background hover:bg-muted transition-colors'
            }
          >
            <Code className="mr-2 size-5" />
            {t.projectDetailPage?.viewCodeButton ?? 'View Code'}
          </a>
        )
      }
    </div>
  </article>
</div>
