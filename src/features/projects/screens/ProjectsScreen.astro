---
import Heading from '@/components/Heading.astro';
import type { LanguageCode, ui } from '@/i18n/ui';
import ProjectGrid from '../components/ProjectGrid.astro';
import type { TranslatedProject } from '../type';

export type Props = {
  /** Highlighted projects first, in showcase order, then the Archives. */
  highlighted: Array<TranslatedProject>;
  archives: Array<TranslatedProject>;
  t: (typeof ui)[LanguageCode];
  lang: LanguageCode;
};

const { highlighted, archives, t, lang } = Astro.props;
const copy = t.projectsPage;
---

<div class="py-12 md:py-16">
  <Heading title={copy.title} description={copy.featuredDescription} />

  <section id="featured" class="mb-20" aria-labelledby="featured-title">
    <h2 id="featured-title" class="sr-only">{copy.featuredTitle}</h2>
    <ProjectGrid projects={highlighted} lang={lang} />
  </section>

  {
    archives.length > 0 ? (
      <section
        id="archives"
        aria-labelledby="archives-title"
        class="border-t border-border pt-12"
      >
        <div class="mb-8">
          <h2
            id="archives-title"
            class="font-heading text-2xl font-semibold tracking-tight"
          >
            {copy.archivesTitle}
          </h2>
          <p class="mt-2 max-w-3xl text-muted-foreground">
            {copy.archivesDescription}
          </p>
        </div>
        <ProjectGrid projects={archives} lang={lang} />
      </section>
    ) : null
  }
</div>
