---
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, Dumbbell, ArrowRight, Building2 } from 'lucide-react';

import heroImage from '@/assets/bakate-hero.jpeg';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import type { TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroGreeting: string;
  heroSubtitlePart1: string;
  heroSubtitlePart2: string;
  heroIntroduction: string;
  heroIntroduction2: string;
  heroViewWorkButton: string;
  heroContactButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  bloomflowTitle: string;
  bloomflowDescription: string;
  bloomflowCta: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string; // Added for specific project CTA
};

const {
  lang,
  projects,
  skills,
  heroGreeting,
  heroSubtitlePart1,
  heroIntroduction2,
  heroSubtitlePart2,
  heroIntroduction,
  heroViewWorkButton,
  heroContactButton,
  featuredProjectsTitle,
  featuredProjectsDescription,
  bloomflowTitle,
  bloomflowDescription,
  bloomflowCta,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;

const featuredProjectSlugs = ['parent-up', 'bloomflow', 'terralhub'] as const;
const featuredProjects = featuredProjectSlugs
  .map((featuredSlug) => {
    return projects.find((project) => project.slug === featuredSlug);
  })
  .filter((project): project is TranslatedProject => project !== undefined);

const bloomflowHighlights = [
  'Angular',
  'TypeScript',
  'RxJS',
  'NgRx',
  'Architecture Frontend',
  'Design System',
  'Industrialisation',
] as const;
---

<section class="py-12 md:py-16">
  <div class="grid md:grid-cols-2 gap-12 items-center justify-between">
    {/* Hero Text Column */}
    <div class="text-center md:text-left">
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-6"
      >
        {heroGreeting}
      </h1>
      <p class="text-xl md:text-2xl font-medium text-muted-foreground mb-4">
        <span class="text-foreground/90">{heroSubtitlePart1}</span>
        <span class="text-primary mx-2">|</span>
        <span class="text-foreground/90">{heroSubtitlePart2}</span>
      </p>
      <p
        class="text-lg text-muted-foreground mb-2 max-w-2xl mx-auto md:mx-0 leading-relaxed"
      >
        {heroIntroduction}
      </p>
      <p
        class="text-lg text-muted-foreground mb-10 max-w-2xl mx-auto md:mx-0 leading-relaxed"
      >
        {heroIntroduction2}
      </p>
      <div
        class="flex flex-col sm:flex-row gap-5 justify-center md:justify-start"
      >
        <a
          href="/projects"
          class={buttonVariants({
            variant: 'default',
            size: 'lg',
          })}
        >
          <Dumbbell className="mr-2 size-5" />
          {heroViewWorkButton}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/contact')}
          class={buttonVariants({
            variant: 'outline',
            size: 'lg',
          })}
        >
          <Calendar className="mr-2 size-5" />
          {heroContactButton}
        </a>
      </div>
    </div>

    {/* Hero Image (Placeholder for now) */}
    <div class="md:text-right flex justify-center md:justify-end mt-12 md:mt-0">
      <div
        class="w-full max-w-[600px] aspect-[4/3] rounded-lg overflow-hidden border border-border bg-muted"
      >
        <Image
          src={heroImage}
          alt={'User profile image'}
          width={800}
          height={600}
          densities={[1, 1.5, 2]}
          quality="high"
          class="h-full w-full object-cover"
          style="object-position: center 25%;"
        />
      </div>
    </div>
  </div>
</section>

{/* Featured Projects Section */}
<section
  id="projects"
  class="py-16 md:py-24 my-12 rounded-lg bg-muted/40 border border-border px-6 md:px-12"
>
  <Heading
    title={featuredProjectsTitle}
    description={featuredProjectsDescription}
    className="mb-12"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      featuredProjects.map((project: TranslatedProject) => {
        return (
          <FeaturedProjectPreview
            lang={lang}
            slug={project.slug}
            title={project.title}
            imageUrl={project.imageUrl}
            imageAltText={project.imageAltText}
            ctaText={projectPreviewCtaText}
          />
        );
      })
    }
  </div>
</section>

{/* Bloomflow Section */}
<section
  class="py-14 md:py-18 my-12 rounded-lg border border-border bg-card px-6 md:px-12"
>
  <div class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-center">
    <div>
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/30 px-4 py-2 text-sm font-medium text-primary"
      >
        <Building2 className="size-4" />
        Bloomflow · Angular · SaaS B2B
      </div>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
        {bloomflowTitle}
      </h2>
      <p class="text-muted-foreground leading-relaxed max-w-3xl">
        {bloomflowDescription}
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-wrap gap-2">
        {
          bloomflowHighlights.map((highlight) => (
            <span class="rounded-full border border-border/60 bg-background/60 px-3 py-1 text-sm text-foreground/90">
              {highlight}
            </span>
          ))
        }
      </div>
      <a
        href={getRelativeLocaleUrl(lang, '/experience')}
        class={buttonVariants({
          variant: 'default',
          size: 'lg',
          className: 'w-fit',
        })}
      >
        {bloomflowCta}
        <ArrowRight className="ml-2 size-5" />
      </a>
    </div>
  </div>
</section>

{/* Skills Section */}
<section id="skills" class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <Heading
      title={mySkillsTitle}
      description={mySkillsDescription}
      className="mb-12"
    />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {
        skills.map((skill) => (
          <SkillCard
            title={skill.title}
            description={skill.description}
            iconName={skill.iconName}
            technologies={skill.technologies}
          />
        ))
      }
    </div>
  </div>
</section>
