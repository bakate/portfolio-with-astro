---
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, Dumbbell } from 'lucide-react';

import heroImage from '@/assets/bakate-hero.jpeg';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import type { TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroGreeting: string;
  heroSubtitlePart1: string;
  heroSubtitlePart2: string;
  heroIntroduction: string;
  heroViewWorkButton: string;
  heroContactButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string; // Added for specific project CTA
};

const {
  lang,
  projects,
  skills,
  heroGreeting,
  heroSubtitlePart1,
  heroSubtitlePart2,
  heroIntroduction,
  heroViewWorkButton,
  heroContactButton,
  featuredProjectsTitle,
  featuredProjectsDescription,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;
---

<section class="py-12 md:py-16 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-primary/15 via-background to-background -z-10"
  >
  </div>
  <div
    class="grid md:grid-cols-2 gap-12 items-center justify-between relative z-10"
  >
    {/* Hero Text Column */}
    <div class="text-center md:text-left">
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 bg-gradient-to-br from-foreground to-foreground/70 bg-clip-text text-transparent"
      >
        {heroGreeting}
      </h1>
      <p class="text-xl md:text-2xl font-medium text-muted-foreground mb-4">
        <span class="text-foreground/90">{heroSubtitlePart1}</span>
        <span class="text-primary mx-2">|</span>
        <span class="text-foreground/90">{heroSubtitlePart2}</span>
      </p>
      <p
        class="text-lg text-muted-foreground/80 mb-10 max-w-2xl mx-auto md:mx-0 leading-relaxed"
      >
        {heroIntroduction}
      </p>
      <div
        class="flex flex-col sm:flex-row gap-5 justify-center md:justify-start"
      >
        <a
          href="/projects"
          class={buttonVariants({
            variant: 'default',
            size: 'lg',
            className:
              'shadow-lg shadow-primary/20 hover:-translate-y-1 transition-transform',
          })}
        >
          <Dumbbell className="mr-2 size-5" />
          {heroViewWorkButton}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/contact')}
          class={buttonVariants({
            variant: 'outline',
            size: 'lg',
            className:
              'hover:bg-muted/50 hover:-translate-y-1 transition-transform',
          })}
        >
          <Calendar className="mr-2 size-5" />
          {heroContactButton}
        </a>
      </div>
    </div>

    {/* Hero Image (Placeholder for now) */}
    <div
      class="md:text-right flex justify-center md:justify-end mt-12 md:mt-0 perspective-1000"
    >
      <div
        class="w-full max-w-[600px] aspect-[4/3] rounded-2xl shadow-2xl shadow-primary/10 overflow-hidden border border-border/50 bg-muted/30 hover:scale-[1.02] hover:-rotate-1 transition-all duration-500 will-change-transform"
      >
        <Image
          src={heroImage}
          alt={'User profile image'}
          width={800}
          height={600}
          densities={[1, 1.5, 2]}
          quality="high"
          class="h-full w-full object-cover"
          style="object-position: center 25%;"
        />
      </div>
    </div>
  </div>
</section>

{/* Featured Projects Section */}
<section
  id="projects"
  class="py-16 md:py-24 my-12 rounded-[2.5rem] bg-gradient-to-b from-muted/30 to-muted/10 border border-border/50 shadow-sm relative overflow-hidden px-6 md:px-12"
>
  <div
    class="absolute top-0 right-0 p-32 bg-primary/5 rounded-full blur-[100px] -z-10 mix-blend-multiply dark:mix-blend-screen"
  >
  </div>
  <Heading
    title={featuredProjectsTitle}
    description={featuredProjectsDescription}
    className="flex flex-col items-center mb-12 relative z-10"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.slice(0, 3).map((project: TranslatedProject) => {
        return (
          <FeaturedProjectPreview
            lang={lang}
            slug={project.slug}
            title={project.title}
            imageUrl={project.imageUrl}
            imageAltText={project.imageAltText}
            ctaText={projectPreviewCtaText}
          />
        );
      })
    }
  </div>
</section>

{/* Skills Section */}
<section id="skills" class="py-16 md:py-24 relative overflow-hidden">
  <div class="absolute bottom-0 left-0 p-40 bg-primary/5 rounded-full blur-[100px] -z-10 mix-blend-multiply dark:mix-blend-screen" />
  <div class="container mx-auto px-4 relative z-10">
    <Heading
      title={mySkillsTitle}
      description={mySkillsDescription}
      className="flex flex-col items-center mb-12"
    />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {
        skills.map((skill) => (
          <SkillCard
            title={skill.title}
            description={skill.description}
            iconName={skill.iconName}
            technologies={skill.technologies}
          />
        ))
      }
    </div>
  </div>
</section>
