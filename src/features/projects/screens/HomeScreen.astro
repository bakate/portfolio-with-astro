---
import Heading from '@/components/Heading.astro';
import RevealOnScroll from '@/components/RevealOnScroll.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { profile } from '@/lib/profile';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, FileDown } from 'lucide-react';
import {
  ExperienceSummary,
  type ExperienceSummaryEntry,
} from '@/features/experience';

import heroImage from '@/assets/bakate-portrait.png';
import { Image } from 'astro:assets';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProofSection from '@/features/projects/components/ProofSection.astro';
import HowIWork, {
  type Props as HowIWorkProps,
} from '../components/HowIWork.astro';
import type { Proof, TranslatedProject } from '../type';
import {
  LatestContent,
  type LatestContentCopy,
  type LatestContentEntry,
} from '@/features/latest-content';

export type Props = {
  lang: LanguageCode;
  /** The home page's featured projects, in showcase order. */
  featuredProjects: Array<TranslatedProject>;
  heroPitch: string;
  heroAvailability: string;
  heroBookCallButton: string;
  heroDownloadCvButton: string;
  heroImageAlt: string;
  proofTitle: string;
  proofs: Array<Proof>;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  experience: {
    title: string;
    description: string;
    cta: string;
    entries: ReadonlyArray<ExperienceSummaryEntry>;
  };
  howIWork: HowIWorkProps;
  latestContent: {
    copy: LatestContentCopy;
    /** Empty while nothing recent is published: the section is then left out. */
    entries: ReadonlyArray<LatestContentEntry>;
  };
};

const {
  lang,
  featuredProjects,
  heroPitch,
  heroAvailability,
  heroBookCallButton,
  heroDownloadCvButton,
  heroImageAlt,
  proofTitle,
  proofs,
  featuredProjectsTitle,
  featuredProjectsDescription,
  experience,
  howIWork,
  latestContent,
} = Astro.props;
---

<section id="hero" class="pt-12 pb-4 md:pt-20 md:pb-8">
  <div class="max-w-3xl">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-border/60 px-3 py-1 text-sm text-muted-foreground mb-8"
    >
      <span class="size-2 rounded-full bg-green-500" aria-hidden="true"></span>
      {heroAvailability}
    </p>
    <div class="flex items-center gap-4 sm:gap-6 mb-6">
      <Image
        src={heroImage}
        alt={heroImageAlt}
        width={224}
        height={224}
        loading="eager"
        quality="high"
        class="size-20 sm:size-24 md:size-28 shrink-0 rounded-md border border-border object-cover"
      />
      <div class="min-w-0">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-2"
        >
          {profile.displayName}
        </h1>
        <p class="text-lg md:text-2xl font-medium text-foreground/90">
          {profile.jobTitle}
        </p>
      </div>
    </div>
    <p class="text-lg text-muted-foreground mb-10 leading-relaxed">
      {heroPitch}
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={profile.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({
          variant: 'default',
          size: 'lg',
        })}
      >
        <Calendar className="mr-2 size-5" />
        {heroBookCallButton}
      </a>
      <a
        href={profile.cvPathByLanguage[lang]}
        download
        class={buttonVariants({
          variant: 'outline',
          size: 'lg',
        })}
      >
        <FileDown className="mr-2 size-5" />
        {heroDownloadCvButton}
      </a>
    </div>
  </div>
</section>

<RevealOnScroll>
  <ProofSection title={proofTitle} proofs={proofs} />
</RevealOnScroll>

<RevealOnScroll>
  <ExperienceSummary
    title={experience.title}
    description={experience.description}
    cta={experience.cta}
    ctaHref={getRelativeLocaleUrl(lang, '/experience')}
    entries={experience.entries}
  />
</RevealOnScroll>

<RevealOnScroll>
  <section id="projects" class="py-16 md:py-24">
    <Heading
      title={featuredProjectsTitle}
      description={featuredProjectsDescription}
      className="mb-12"
    />

    <ProjectGrid projects={featuredProjects} lang={lang} />
  </section>
</RevealOnScroll>

<RevealOnScroll>
  <HowIWork {...howIWork} />
</RevealOnScroll>

<RevealOnScroll>
  <LatestContent
    lang={lang}
    copy={latestContent.copy}
    entries={latestContent.entries}
  />
</RevealOnScroll>
