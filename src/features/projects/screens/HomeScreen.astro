---
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { profile } from '@/lib/profile';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, FileDown, ArrowRight, Building2 } from 'lucide-react';

import heroImage from '@/assets/bakate-portrait.png';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import ProofSection from '@/features/projects/components/ProofSection.astro';
import type { Proof, TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroPitch: string;
  heroAvailability: string;
  heroBookCallButton: string;
  heroDownloadCvButton: string;
  heroImageAlt: string;
  proofTitle: string;
  proofs: Array<Proof>;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  bloomflowTitle: string;
  bloomflowDescription: string;
  bloomflowCta: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string; // Added for specific project CTA
};

const {
  lang,
  projects,
  skills,
  heroPitch,
  heroAvailability,
  heroBookCallButton,
  heroDownloadCvButton,
  heroImageAlt,
  proofTitle,
  proofs,
  featuredProjectsTitle,
  featuredProjectsDescription,
  bloomflowTitle,
  bloomflowDescription,
  bloomflowCta,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;

const featuredProjectSlugs = ['parent-up', 'bloomflow', 'terralhub'] as const;
const featuredProjects = featuredProjectSlugs
  .map((featuredSlug) => {
    return projects.find((project) => project.slug === featuredSlug);
  })
  .filter((project): project is TranslatedProject => project !== undefined);

const bloomflowHighlights = [
  'Angular',
  'TypeScript',
  'RxJS',
  'NgRx',
  'Architecture Frontend',
  'Design System',
  'Industrialisation',
] as const;
---

<section id="hero" class="pt-12 pb-4 md:pt-20 md:pb-8">
  <div class="max-w-3xl">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-border/60 px-3 py-1 text-sm text-muted-foreground mb-8"
    >
      <span class="size-2 rounded-full bg-green-500" aria-hidden="true"></span>
      {heroAvailability}
    </p>
    <div class="flex items-center gap-4 sm:gap-6 mb-6">
      <Image
        src={heroImage}
        alt={heroImageAlt}
        width={224}
        height={224}
        loading="eager"
        quality="high"
        class="size-20 sm:size-24 md:size-28 shrink-0 rounded-md border border-border object-cover"
      />
      <div class="min-w-0">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-2"
        >
          {profile.displayName}
        </h1>
        <p class="text-lg md:text-2xl font-medium text-foreground/90">
          {profile.jobTitle}
        </p>
      </div>
    </div>
    <p class="text-lg text-muted-foreground mb-10 leading-relaxed">
      {heroPitch}
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={profile.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonVariants({
          variant: 'default',
          size: 'lg',
        })}
      >
        <Calendar className="mr-2 size-5" />
        {heroBookCallButton}
      </a>
      <a
        href={profile.cvPathByLanguage[lang]}
        download
        class={buttonVariants({
          variant: 'outline',
          size: 'lg',
        })}
      >
        <FileDown className="mr-2 size-5" />
        {heroDownloadCvButton}
      </a>
    </div>
  </div>
</section>

<ProofSection title={proofTitle} proofs={proofs} />

{/* Featured Projects Section */}
<section
  id="projects"
  class="py-16 md:py-24 my-12 rounded-lg bg-muted/40 border border-border px-6 md:px-12"
>
  <Heading
    title={featuredProjectsTitle}
    description={featuredProjectsDescription}
    className="mb-12"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      featuredProjects.map((project: TranslatedProject) => {
        return (
          <FeaturedProjectPreview
            lang={lang}
            slug={project.slug}
            title={project.title}
            imageUrl={project.imageUrl}
            imageAltText={project.imageAltText}
            ctaText={projectPreviewCtaText}
          />
        );
      })
    }
  </div>
</section>

{/* Bloomflow Section */}
<section
  class="py-14 md:py-18 my-12 rounded-lg border border-border bg-card px-6 md:px-12"
>
  <div class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-center">
    <div>
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/30 px-4 py-2 text-sm font-medium text-primary"
      >
        <Building2 className="size-4" />
        Bloomflow · Angular · SaaS B2B
      </div>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
        {bloomflowTitle}
      </h2>
      <p class="text-muted-foreground leading-relaxed max-w-3xl">
        {bloomflowDescription}
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-wrap gap-2">
        {
          bloomflowHighlights.map((highlight) => (
            <span class="rounded-full border border-border/60 bg-background/60 px-3 py-1 text-sm text-foreground/90">
              {highlight}
            </span>
          ))
        }
      </div>
      <a
        href={getRelativeLocaleUrl(lang, '/experience')}
        class={buttonVariants({
          variant: 'default',
          size: 'lg',
          className: 'w-fit',
        })}
      >
        {bloomflowCta}
        <ArrowRight className="ml-2 size-5" />
      </a>
    </div>
  </div>
</section>

{/* Skills Section */}
<section id="skills" class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <Heading
      title={mySkillsTitle}
      description={mySkillsDescription}
      className="mb-12"
    />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {
        skills.map((skill) => (
          <SkillCard
            title={skill.title}
            description={skill.description}
            iconName={skill.iconName}
            technologies={skill.technologies}
          />
        ))
      }
    </div>
  </div>
</section>
