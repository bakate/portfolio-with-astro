---
import Heading from '@/components/Heading.astro';
import SkillCard from '@/components/SkillCard.astro';
import { buttonVariants } from '@/components/ui/button';
import type { LanguageCode } from '@/i18n/ui';
import { profile } from '@/lib/profile';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, FileDown, ArrowRight, Building2 } from 'lucide-react';

import heroImage from '@/assets/bakate-portrait.png';
import { Image } from 'astro:assets';
import FeaturedProjectPreview from '../components/FeaturedProjectPreview.astro';
import type { TranslatedProject, TranslatedSkill } from '../type';

export type Props = {
  lang: LanguageCode;
  projects: Array<TranslatedProject>;
  skills: Array<TranslatedSkill>;
  heroPitch: string;
  heroAvailability: string;
  heroBookCallButton: string;
  heroDownloadCvButton: string;
  imageNotAvailable: string;
  featuredProjectsTitle: string;
  featuredProjectsDescription: string;
  bloomflowTitle: string;
  bloomflowDescription: string;
  bloomflowCta: string;
  mySkillsTitle: string;
  mySkillsDescription: string;
  projectPreviewCtaText: string; // Added for specific project CTA
};

const {
  lang,
  projects,
  skills,
  heroPitch,
  heroAvailability,
  heroBookCallButton,
  heroDownloadCvButton,
  featuredProjectsTitle,
  featuredProjectsDescription,
  bloomflowTitle,
  bloomflowDescription,
  bloomflowCta,
  mySkillsTitle,
  mySkillsDescription,
  projectPreviewCtaText,
} = Astro.props;

const featuredProjectSlugs = ['parent-up', 'bloomflow', 'terralhub'] as const;
const featuredProjects = featuredProjectSlugs
  .map((featuredSlug) => {
    return projects.find((project) => project.slug === featuredSlug);
  })
  .filter((project): project is TranslatedProject => project !== undefined);

const bloomflowHighlights = [
  'Angular',
  'TypeScript',
  'RxJS',
  'NgRx',
  'Architecture Frontend',
  'Design System',
  'Industrialisation',
] as const;
---

<section id="hero" class="py-12 md:py-16 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-primary/15 via-background to-background -z-10"
  >
  </div>
  <div
    class="grid md:grid-cols-2 gap-12 items-center justify-between relative z-10"
  >
    {/* Hero Text Column */}
    <div class="text-center md:text-left">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border/60 px-3 py-1 text-sm text-muted-foreground mb-6"
      >
        <span class="size-2 rounded-full bg-green-500" aria-hidden="true"
        ></span>
        {heroAvailability}
      </p>
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight mb-6 bg-gradient-to-br from-foreground to-foreground/70 bg-clip-text text-transparent"
      >
        {profile.displayName}
      </h1>
      <p class="text-xl md:text-2xl font-medium text-muted-foreground mb-4">
        <span class="text-foreground/90">{profile.jobTitle}</span>
      </p>
      <p
        class="text-lg text-muted-foreground/80 mb-10 max-w-2xl mx-auto md:mx-0 leading-relaxed"
      >
        {heroPitch}
      </p>
      <div
        class="flex flex-col sm:flex-row gap-5 justify-center md:justify-start"
      >
        <a
          href={profile.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({
            variant: 'default',
            size: 'lg',
            className:
              'shadow-lg shadow-primary/20 hover:-translate-y-1 transition-transform',
          })}
        >
          <Calendar className="mr-2 size-5" />
          {heroBookCallButton}
        </a>
        <a
          href={profile.cvPathByLanguage[lang]}
          download
          class={buttonVariants({
            variant: 'outline',
            size: 'lg',
            className:
              'hover:bg-muted/50 hover:-translate-y-1 transition-transform',
          })}
        >
          <FileDown className="mr-2 size-5" />
          {heroDownloadCvButton}
        </a>
      </div>
    </div>

    {/* Hero Image (Placeholder for now) */}
    <div
      class="md:text-right flex justify-center md:justify-end mt-12 md:mt-0 perspective-1000"
    >
      <div
        class="w-full max-w-[420px] aspect-square rounded-2xl shadow-2xl shadow-primary/10 overflow-hidden border border-border/50 bg-muted/30 hover:scale-[1.02] hover:-rotate-1 transition-all duration-500 will-change-transform"
      >
        <Image
          src={heroImage}
          alt={profile.displayName}
          width={576}
          height={576}
          quality="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>

{/* Featured Projects Section */}
<section
  id="projects"
  class="py-16 md:py-24 my-12 rounded-[2.5rem] bg-gradient-to-b from-muted/30 to-muted/10 border border-border/50 shadow-sm relative overflow-hidden px-6 md:px-12"
>
  <div
    class="absolute top-0 right-0 p-32 bg-primary/5 rounded-full blur-[100px] -z-10 mix-blend-multiply dark:mix-blend-screen"
  >
  </div>
  <Heading
    title={featuredProjectsTitle}
    description={featuredProjectsDescription}
    className="mb-12 relative z-10"
  />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      featuredProjects.map((project: TranslatedProject) => {
        return (
          <FeaturedProjectPreview
            lang={lang}
            slug={project.slug}
            title={project.title}
            imageUrl={project.imageUrl}
            imageAltText={project.imageAltText}
            ctaText={projectPreviewCtaText}
          />
        );
      })
    }
  </div>
</section>

{/* Bloomflow Section */}
<section
  class="py-14 md:py-18 my-12 rounded-[2rem] border border-primary/20 bg-primary/5 px-6 md:px-12 shadow-sm relative overflow-hidden"
>
  <div class="absolute right-0 top-0 p-28 bg-primary/10 blur-[100px] -z-10">
  </div>
  <div class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-center">
    <div>
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-background/50 px-4 py-2 text-sm font-medium text-primary"
      >
        <Building2 className="size-4" />
        Bloomflow · Angular · SaaS B2B
      </div>
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4">
        {bloomflowTitle}
      </h2>
      <p class="text-muted-foreground leading-relaxed max-w-3xl">
        {bloomflowDescription}
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-wrap gap-2">
        {
          bloomflowHighlights.map((highlight) => (
            <span class="rounded-full border border-border/60 bg-background/60 px-3 py-1 text-sm text-foreground/90">
              {highlight}
            </span>
          ))
        }
      </div>
      <a
        href={getRelativeLocaleUrl(lang, '/experience')}
        class={buttonVariants({
          variant: 'default',
          size: 'lg',
          className:
            'w-fit shadow-lg shadow-primary/20 hover:-translate-y-1 transition-transform',
        })}
      >
        {bloomflowCta}
        <ArrowRight className="ml-2 size-5" />
      </a>
    </div>
  </div>
</section>

{/* Skills Section */}
<section id="skills" class="py-16 md:py-24 relative overflow-hidden">
  <div
    class="absolute bottom-0 left-0 p-40 bg-primary/5 rounded-full blur-[100px] -z-10 mix-blend-multiply dark:mix-blend-screen"
  >
  </div>
  <div class="container mx-auto px-4 relative z-10">
    <Heading
      title={mySkillsTitle}
      description={mySkillsDescription}
      className="mb-12"
    />
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
      {
        skills.map((skill) => (
          <SkillCard
            title={skill.title}
            description={skill.description}
            iconName={skill.iconName}
            technologies={skill.technologies}
          />
        ))
      }
    </div>
  </div>
</section>
