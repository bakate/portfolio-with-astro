---
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { useTranslations, type LanguageCode } from '@/i18n/ui';
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Code, ExternalLink } from 'lucide-react';
import type { ShowcaseLevel, TranslatedProject } from '../type';

export type Props = {
  project: TranslatedProject;
  lang: LanguageCode;
};

const { project, lang } = Astro.props;
const t = useTranslations(lang, 'projectCard');
const detailUrl = getRelativeLocaleUrl(lang, `/projects/${project.slug}`);

const look = {
  large: {
    image: 'aspect-[16/10]',
    title: 'text-2xl',
    description: '',
    tags: 6,
  },
  compact: {
    image: 'aspect-[16/9]',
    title: 'text-xl',
    description: 'line-clamp-3',
    tags: 4,
  },
  archive: {
    image: undefined,
    title: 'text-lg',
    description: 'line-clamp-2',
    tags: 3,
  },
} as const satisfies Record<
  ShowcaseLevel,
  { image?: string; title: string; description: string; tags: number }
>;
const style = look[project.showcase];
const showsImage = style.image !== undefined && project.imageUrl !== undefined;
---

<article
  class={cn(
    'flex h-full flex-col overflow-hidden rounded-lg border border-border bg-card',
    project.showcase === 'archive' && 'bg-muted/30'
  )}
>
  {
    showsImage && project.imageUrl && (
      <a
        href={detailUrl}
        tabindex="-1"
        aria-hidden="true"
        class={cn('block overflow-hidden border-b border-border', style.image)}
      >
        <Image
          src={project.imageUrl}
          alt=""
          class="h-full w-full object-cover object-top"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          quality="mid"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    {
      project.categoryText && (
        <p class="text-sm text-muted-foreground">{project.categoryText}</p>
      )
    }
    <h3 class={cn('font-heading font-semibold tracking-tight', style.title)}>
      <a
        href={detailUrl}
        class="underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
      >
        {project.title}
      </a>
    </h3>
    <p class={cn('text-muted-foreground leading-relaxed', style.description)}>
      {project.description}
    </p>
    {
      project.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Technologies">
          {project.tags.slice(0, style.tags).map((tag) => (
            <li>
              <Badge variant="secondary">{tag}</Badge>
            </li>
          ))}
        </ul>
      )
    }
    <div class="mt-auto flex flex-wrap gap-3 pt-3">
      <a
        href={detailUrl}
        class={buttonVariants({ variant: 'default', size: 'sm' })}
      >
        {t('viewProject')}
        <span class="sr-only"> · {project.title}</span>
      </a>
      {
        project.projectUrl && (
          <a
            href={project.projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({ variant: 'outline', size: 'sm' })}
          >
            <ExternalLink className="mr-1.5 size-4" />
            {t('viewDemo')}
            <span class="sr-only"> · {project.title}</span>
          </a>
        )
      }
      {
        project.codeUrl && (
          <a
            href={project.codeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({ variant: 'outline', size: 'sm' })}
          >
            <Code className="mr-1.5 size-4" />
            {t('viewCode')}
            <span class="sr-only"> · {project.title}</span>
          </a>
        )
      }
    </div>
  </div>
</article>
