---
export type Practice = {
  title: string;
  description: string;
};

export type Props = {
  title: string;
  description: string;
  practices: ReadonlyArray<Practice>;
  careerChangeTitle: string;
  careerChange: string;
};

const { title, description, practices, careerChangeTitle, careerChange } =
  Astro.props;
---

<section id="how-i-work" class="py-16 md:py-24">
  <div class="max-w-3xl">
    <h2 class="font-heading text-2xl font-bold tracking-tight sm:text-3xl">
      {title}
    </h2>
    <p class="mt-4 text-muted-foreground">{description}</p>
  </div>

  <ul class="mt-12 grid gap-10 md:grid-cols-3">
    {
      practices.map((practice) => (
        <li class="border-t-2 border-primary pt-6">
          <h3 class="font-heading text-lg font-semibold tracking-tight">
            {practice.title}
          </h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">
            {practice.description}
          </p>
        </li>
      ))
    }
  </ul>

  <div class="mt-16 max-w-3xl border-l-2 border-border pl-6">
    <h3 class="font-heading text-lg font-semibold tracking-tight">
      {careerChangeTitle}
    </h3>
    <p class="mt-3 leading-relaxed text-muted-foreground">{careerChange}</p>
  </div>
</section>
