---
import TableOfContents from '@/components/TableOfContents.astro';
import type { LanguageCode } from '@/i18n/ui';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowLeft } from 'lucide-react';
import BlogPostEntry from '../components/BlogPostEntry.astro';

type Props = {
  post: CollectionEntry<'blog'>['data'] & { readingTimeMinutes: number };
  lang: LanguageCode;
  headings: Array<{ depth: number; text: string; slug: string }>;
  relatedPosts: Array<CollectionEntry<'blog'>>;
  filePath: string;
};

const { post, lang, headings, relatedPosts, filePath } = Astro.props;

const editUrl = `https://github.com/bakate/portfolio/edit/main/${filePath}`;
const t = useTranslations(lang, 'blogPost');
const blogHref = getRelativeLocaleUrl(lang, '/blog');
const { title, description, pubDate, updatedDate, heroImage, tags = [] } = post;
---

<BaseLayout
  pageTitle={title}
  pageDescription={description}
  noIndex={post.isDraft}
>
  <div
    class="grid grid-cols-1 gap-12 py-12 md:py-16 xl:grid-cols-[minmax(0,75ch)_250px] xl:justify-between"
  >
    <article class="min-w-0">
      <a
        href={blogHref}
        class="inline-flex items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        <ArrowLeft className="size-4" aria-hidden="true" />
        {t('backToList')}
      </a>

      <header class="mt-8 mb-12 border-b border-border pb-8">
        <h1
          class="font-heading text-3xl font-bold leading-tight tracking-tight sm:text-4xl md:text-5xl"
        >
          {title}
        </h1>
        <p class="mt-6 text-sm text-muted-foreground">
          {t('publishedOn')}
          <time datetime={pubDate.toISOString()}>
            {formatDate(pubDate, lang)}
          </time>
          {
            updatedDate && (
              <>
                {' · '}
                {t('updatedOn')}
                <time datetime={updatedDate.toISOString()}>
                  {formatDate(updatedDate, lang)}
                </time>
              </>
            )
          }
          {' · '}
          {`${post.readingTimeMinutes} ${t('readingTimeSuffix')}`}
        </p>
        {
          tags.length > 0 && (
            <p class="mt-2 text-sm text-muted-foreground">{tags.join(' · ')}</p>
          )
        }
        {
          heroImage && (
            <Image
              src={heroImage.url}
              alt={heroImage.alt}
              class="mt-8 h-auto w-full rounded-md border border-border object-cover"
              width={768}
              height={432}
            />
          )
        }
      </header>

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <slot />
      </div>

      <p class="mt-16 border-t border-border pt-8 text-sm">
        <a
          href={editUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground underline-offset-4 hover:text-primary hover:underline"
        >
          {t('editOnGithub')}
        </a>
      </p>

      {
        relatedPosts.length > 0 && (
          <section class="mt-16">
            <h2 class="font-heading text-2xl font-bold tracking-tight">
              {t('relatedPostsTitle')}
            </h2>
            <div class="mt-8 border-t border-border">
              {relatedPosts.map((relatedPost) => (
                <BlogPostEntry
                  post={relatedPost}
                  lang={lang}
                  headingLevel={3}
                />
              ))}
            </div>
          </section>
        )
      }
    </article>

    <aside class="hidden xl:block">
      <TableOfContents headings={headings} lang={lang} />
    </aside>
  </div>
</BaseLayout>
