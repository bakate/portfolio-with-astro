---
import EditorialEntry from '@/components/EditorialEntry.astro';
import FilterableList from '@/components/filterable-list/FilterableList.astro';
import { ui, type LanguageCode } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedEntries } from '@/lib/published-content';
import { getRelativeLocaleUrl } from 'astro:i18n';

type Props = {
  lang: LanguageCode;
};

const { lang } = Astro.props;
const copy = ui[lang].blogPage;
const posts = await getPublishedEntries('blog', lang);
---

<BaseLayout pageTitle={copy.pageTitle} pageDescription={copy.pageDescription}>
  <section class="py-12 md:py-16">
    <header class="mb-12 max-w-3xl">
      <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-4 text-muted-foreground">{copy.description}</p>
    </header>

    <FilterableList
      entries={posts.map((post) => ({
        id: post.id,
        searchText: [post.data.title, post.data.description, post.body].join(
          '\n'
        ),
        tags: post.data.tags ?? [],
      }))}
      copy={{
        searchLabel: copy.searchLabel,
        searchPlaceholder: copy.searchPlaceholder,
        tagPickerLabel: copy.filterByTagButtonLabel,
        allTagsLabel: copy.allTagsLabel,
        tagSearchPlaceholder: copy.selectTagCommandPlaceholder,
        noTagFound: copy.noTagFound,
        noResults: copy.noPostsFound,
      }}
    >
      {
        posts.map((post) => (
          <EditorialEntry
            filterId={post.id}
            title={post.data.title}
            href={getRelativeLocaleUrl(lang, `/blog/${post.id}`)}
            description={post.data.description}
            pubDate={post.data.pubDate}
            lang={lang}
            headingLevel={2}
            details={[
              `${post.data.readingTimeMinutes} ${copy.readingTimeSuffix}`,
            ]}
            tags={post.data.tags}
          />
        ))
      }
    </FilterableList>
  </section>
</BaseLayout>
