---
import {
  FilteredPostsList,
  type PostDataForFilter,
} from '../components/FilteredPostsList';
import BlogPostEntry from '../components/BlogPostEntry.astro';
import type { defaultLanguage, LanguageCode, ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { EmptyState } from '@/components/empty-state';

/**
 * Every string of the blog page, keyed like the French copy: passing
 * `ui[lang].blogPage` fails to compile when a language misses a key.
 */
export type BlogPageCopy = Record<
  keyof (typeof ui)[typeof defaultLanguage]['blogPage'],
  string
>;

type Props = {
  /** Published articles, newest first. */
  posts: Array<CollectionEntry<'blog'>>;
  lang: LanguageCode;
  copy: BlogPageCopy;
};

const { posts, lang, copy } = Astro.props;

const toFilterData = (post: CollectionEntry<'blog'>): PostDataForFilter => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  body: post.body ?? '',
});
---

<BaseLayout pageTitle={copy.pageTitle} pageDescription={copy.pageDescription}>
  <section class="py-12 md:py-16">
    <header class="mb-12 max-w-3xl">
      <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-4 text-muted-foreground">{copy.description}</p>
    </header>

    <FilteredPostsList
      client:load
      allPosts={posts.map(toFilterData)}
      texts={copy}
    />

    <div id="blog-posts-container" class="border-t border-border">
      {
        posts.map((post) => (
          <div class="blog-post-card-wrapper" data-post-id={post.id}>
            <BlogPostEntry post={post} lang={lang} headingLevel={2} />
          </div>
        ))
      }
    </div>
    <EmptyState
      title={copy.noPostsFound}
      id="no-posts-filtered-message"
      className={posts.length > 0 ? 'mt-8 hidden' : 'mt-8'}
    />
  </section>

  <script>
    import {
      filteredPostIdsAtom,
      filtersInitializedAtom,
    } from '@/stores/blogFilterStore';

    const noPostsMessage = document.getElementById('no-posts-filtered-message');
    const wrappers = document.querySelectorAll<HTMLElement>(
      '.blog-post-card-wrapper'
    );

    function updateVisiblePosts() {
      if (!filtersInitializedAtom.get()) return;
      const visibleIds = new Set(filteredPostIdsAtom.get());
      wrappers.forEach((wrapper) => {
        wrapper.hidden = !visibleIds.has(wrapper.dataset.postId ?? '');
      });
      noPostsMessage?.classList.toggle('hidden', visibleIds.size > 0);
    }

    filteredPostIdsAtom.subscribe(updateVisiblePosts);
    filtersInitializedAtom.subscribe(updateVisiblePosts);
  </script>
</BaseLayout>
