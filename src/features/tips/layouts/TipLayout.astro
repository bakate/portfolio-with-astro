---
import TableOfContents from '@/components/TableOfContents.astro';
import { ui, useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ArrowLeft } from 'lucide-react';
import { difficultyLabels } from '../difficulty';

type Props = {
  tip: CollectionEntry<'tips'>;
  headings: Array<{ depth: number; text: string; slug: string }>;
  readingTimeMinutes: number;
};

const { tip, headings, readingTimeMinutes } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  difficulty,
  lang,
  tags = [],
} = tip.data;
const t = useTranslations(lang, 'tipsPage');

const difficultyLabel = difficultyLabels(ui[lang].tipsPage);

const editUrl = `https://github.com/bakate/portfolio/edit/main/${tip.filePath}`;
---

<BaseLayout
  pageTitle={title}
  pageDescription={description}
  noIndex={tip.data.isDraft}
>
  <div
    class="grid grid-cols-1 gap-12 py-12 md:py-16 xl:grid-cols-[minmax(0,75ch)_250px] xl:justify-between"
  >
    <article class="min-w-0">
      <a
        href={getRelativeLocaleUrl(lang, '/tips')}
        class="inline-flex items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        <ArrowLeft className="size-4" aria-hidden="true" />
        {t('backToList')}
      </a>

      <header class="mt-8 mb-12 border-b border-border pb-8">
        <h1
          class="font-heading text-3xl font-bold leading-tight tracking-tight sm:text-4xl"
        >
          {title}
        </h1>
        <p class="mt-6 text-sm text-muted-foreground">
          {t('publishedOn')}{' '}
          <time datetime={pubDate.toISOString()}>
            {formatDate(pubDate, lang)}
          </time>
          {
            updatedDate && (
              <>
                {' · '}
                {t('updatedOn')}{' '}
                <time datetime={updatedDate.toISOString()}>
                  {formatDate(updatedDate, lang)}
                </time>
              </>
            )
          }
          {' · '}
          {`${readingTimeMinutes} ${t('readingTimeSuffix')}`}
          {
            difficulty && (
              <>
                {' · '}
                {t('difficultyLevel')} {difficultyLabel[difficulty]}
              </>
            )
          }
        </p>
        {
          tags.length > 0 && (
            <p class="mt-2 text-sm text-muted-foreground">{tags.join(' · ')}</p>
          )
        }
      </header>

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <slot />
      </div>

      <p class="mt-16 border-t border-border pt-8 text-sm">
        <a
          href={editUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground underline-offset-4 hover:text-primary hover:underline"
        >
          {t('editOnGithub')}
        </a>
      </p>
    </article>

    <aside class="hidden xl:block">
      <TableOfContents headings={headings} lang={lang} />
    </aside>
  </div>
</BaseLayout>
