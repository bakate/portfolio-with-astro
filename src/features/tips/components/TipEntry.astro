---
import type { LanguageCode } from '@/i18n/ui';
import { formatDate } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

type Props = {
  tip: CollectionEntry<'tips'>;
  lang: LanguageCode;
  readingTimeSuffix: string;
  /** The tip's difficulty in the page's language, when it has one. */
  difficultyLabel?: string;
};

const { tip, lang, readingTimeSuffix, difficultyLabel } = Astro.props;
const { title, description, pubDate, readingTimeMinutes, tags = [] } = tip.data;
---

<article
  class="grid gap-2 border-b border-border py-8 md:grid-cols-[12rem_1fr] md:gap-10"
>
  <p class="text-sm text-muted-foreground md:pt-1">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    {
      readingTimeMinutes != null && (
        <span class="block">
          {readingTimeMinutes} {readingTimeSuffix}
        </span>
      )
    }
    {
      difficultyLabel && (
        <span class="block font-medium text-primary">{difficultyLabel}</span>
      )
    }
  </p>
  <div>
    <h2 class="font-heading text-xl font-semibold tracking-tight">
      <a
        href={getRelativeLocaleUrl(lang, `/tips/${tip.id}`)}
        class="underline-offset-4 hover:text-primary hover:underline"
      >
        {title}
      </a>
    </h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {description}
    </p>
    {
      tags.length > 0 && (
        <p class="mt-4 text-sm text-muted-foreground">{tags.join(' · ')}</p>
      )
    }
  </div>
</article>
