---
import { Badge } from '@/components/ui/badge';
import { useTranslations, type LanguageCode } from '@/i18n/ui';
import { formatDate } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Calendar, ChevronRight, Clock, BarChart2 } from 'lucide-react';

interface Props {
  tip: CollectionEntry<'tips'>;
  lang: LanguageCode;
}

const { tip, lang } = Astro.props;
const t = useTranslations(lang, 'tipsPage');

const difficultyLabel = tip.data.difficulty
  ? t(
      `difficulty${tip.data.difficulty.charAt(0).toUpperCase() + tip.data.difficulty.slice(1)}` as any
    )
  : null;
---

<div
  class="group relative flex flex-col sm:flex-row sm:items-center gap-4 p-4 rounded-xl border border-border/50 hover:border-primary/30 hover:bg-primary/5 transition-all duration-300 overflow-hidden shadow-sm hover:shadow-md"
>
  {/* Left Part: Meta info */}
  <div
    class="flex flex-row sm:flex-col items-center sm:items-start gap-3 sm:gap-1 min-w-[120px] text-xs text-muted-foreground border-b sm:border-b-0 sm:border-r border-border/50 pb-2 sm:pb-0 sm:pr-4"
  >
    <div class="flex items-center gap-1.5">
      <Calendar className="size-3.5" />
      <time datetime={tip.data.pubDate.toISOString()}
        >{formatDate(tip.data.pubDate, lang)}</time
      >
    </div>
    <div class="flex items-center gap-1.5">
      <Clock className="size-3.5" />
      <span>{tip.data.readingTimeMinutes} min</span>
    </div>
    {
      tip.data.difficulty && (
        <div class="flex items-center gap-1.5 text-primary font-medium">
          <BarChart2 className="size-3.5" />
          <span>{difficultyLabel}</span>
        </div>
      )
    }
  </div>

  {/* Center Part: Content */}
  <div class="flex-1 space-y-1">
    <div class="flex items-center gap-2">
      <h3
        class="text-lg font-semibold group-hover:text-primary transition-colors"
      >
        <a
          href={getRelativeLocaleUrl(lang, `/tips/${tip.id}/`)}
          class="hover:underline"
        >
          {tip.data.title}
        </a>
      </h3>
      {
        tip.data.featured && (
          <Badge variant="secondary" className="text-[10px] px-1.5 py-0">
            Featured
          </Badge>
        )
      }
    </div>
    <p class="text-sm text-foreground/70 line-clamp-1">
      {tip.data.description}
    </p>

    {
      tip.data.tags && tip.data.tags.length > 0 && (
        <div class="flex gap-1.5 pt-1">
          {tip.data.tags.slice(0, 3).map((tag) => (
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-secondary/50 text-secondary-foreground">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  {/* Right Part: Action */}
  <div class="hidden sm:flex items-center pr-2">
    <ChevronRight
      className="size-5 text-muted-foreground group-hover:text-primary transition-all group-hover:translate-x-1"
    />
  </div>

  {/* Clickable area for the whole row */}
  <a
    href={getRelativeLocaleUrl(lang, `/tips/${tip.id}/`)}
    class="absolute inset-0 z-0 sm:hidden"
  >
    <span class="sr-only">{t('readTip')}</span>
  </a>
</div>
