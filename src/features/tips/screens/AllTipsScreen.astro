---
import EditorialEntry from '@/components/EditorialEntry.astro';
import FilterableList from '@/components/filterable-list/FilterableList.astro';
import { ui, type LanguageCode } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedEntries } from '@/lib/published-content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { difficultyLabels } from '../difficulty';

type Props = {
  lang: LanguageCode;
};

const { lang } = Astro.props;
const copy = ui[lang].tipsPage;
const tips = await getPublishedEntries('tips', lang);
const difficultyLabel = difficultyLabels(copy);
---

<BaseLayout pageTitle={copy.metaTitle} pageDescription={copy.metaDescription}>
  <section class="py-12 md:py-16">
    <header class="mb-12 max-w-3xl">
      <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.title}
      </h1>
      <p class="mt-4 text-muted-foreground">{copy.description}</p>
    </header>

    <FilterableList
      entries={tips.map((tip) => ({
        id: tip.id,
        searchText: [tip.data.title, tip.data.description, tip.body].join('\n'),
        tags: tip.data.tags ?? [],
        difficulty: tip.data.difficulty,
      }))}
      copy={{
        searchLabel: copy.searchLabel,
        searchPlaceholder: copy.searchPlaceholder,
        tagPickerLabel: copy.filterByTagButtonLabel,
        allTagsLabel: copy.allTagsLabel,
        tagSearchPlaceholder: copy.selectTagCommandPlaceholder,
        noTagFound: copy.noTagFound,
        noResults: copy.noTipsFound,
      }}
      difficulty={{
        label: copy.filterByDifficultyLabel,
        allLabel: copy.allDifficulties,
        options: Object.entries(difficultyLabel).map(([value, label]) => ({
          value,
          label,
        })),
      }}
    >
      {
        tips.map((tip) => (
          <EditorialEntry
            filterId={tip.id}
            title={tip.data.title}
            href={getRelativeLocaleUrl(lang, `/tips/${tip.id}`)}
            description={tip.data.description}
            pubDate={tip.data.pubDate}
            lang={lang}
            headingLevel={2}
            label={tip.data.difficulty && difficultyLabel[tip.data.difficulty]}
            details={[
              `${tip.data.readingTimeMinutes} ${copy.readingTimeSuffix}`,
            ]}
            tags={tip.data.tags}
          />
        ))
      }
    </FilterableList>
  </section>
</BaseLayout>
